# MelaScope NCR - Environment Configuration Reference
# Duplicate this file to .env.local and populate the keys relevant to your deployment.

# ==============================================================================
# 1. Google Maps JavaScript API (Optional - Leaflet/OSM fallback runs automatically)
# ==============================================================================
# Create at https://console.cloud.google.com/google/maps-apis/credentials
# Restrict this key by HTTP Referrer in production.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ==============================================================================
# 2. AI Model Provider (Optional - Structured intelligence active)
# ==============================================================================
# Google Gemini API Key from https://aistudio.google.com/
GEMINI_API_KEY=

# ==============================================================================
# 3. Live Web Search Provider (Optional - Curated Delhi NCR index runs if omitted)
# ==============================================================================
# Tavily Search API key from https://tavily.com/
TAVILY_API_KEY=

# Serper Search API key from https://serper.dev/ (alternative to Tavily)
SERPER_API_KEY=

# ==============================================================================
# 4. Database & Storage (Optional - Persistent JSON file storage active by default)
# ==============================================================================
# Supabase PostgreSQL connection details from https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# 5. Security & Authentication
# ==============================================================================
# Private workspace passcode for single-user authentication
APP_PASSWORD=mela2026

# Disable authentication during local offline development (true/false)
APP_DISABLE_AUTH=true
